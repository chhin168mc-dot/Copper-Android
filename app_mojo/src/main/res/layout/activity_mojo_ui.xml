<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF02030A">

    <!-- Animated space, the deepest layer of the launcher -->
    <git.artdeell.mojo.space.SpaceBackgroundView
        android:id="@+id/space_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- A custom launcher background goes over the space when one is set -->
    <com.kdt.mcgui.LauncherWallpaperView
        android:id="@+id/launcher_wallpaper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.kdt.mcgui.AccountSpinner
        android:id="@+id/account_spinner"
        android:layout_width="0dp"
        android:layout_height="@dimen/_42sdp"
        android:popupBackground="@drawable/bg_popup_rounded"
        android:dropDownWidth="wrap_content"
        android:dropDownVerticalOffset="@dimen/_42sdp"
        app:layout_constraintEnd_toStartOf="@+id/quick_menu_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Opens the Quick Actions menu, next to the settings button. It only shows on the home screen -->
    <ImageButton
        android:id="@+id/quick_menu_button"
        android:layout_width="@dimen/_52sdp"
        android:layout_height="@dimen/_42sdp"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="@string/quick_menu_title"
        android:padding="@dimen/_10sdp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_space_menu"
        app:layout_constraintEnd_toStartOf="@+id/setting_button"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/setting_button"
        android:layout_width="@dimen/_52sdp"
        android:layout_height="@dimen/_42sdp"
        android:background="?attr/selectableItemBackground"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_px_sliders"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Holds the main menu and every full screen -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:name="git.artdeell.mojo.fragments.MainMenuFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/progress_layout"
        app:layout_constraintTop_toBottomOf="@+id/account_spinner" />

    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- The opening animation, played once when the app starts -->
    <FrameLayout
        android:id="@+id/intro_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FF02030A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <git.artdeell.mojo.space.SpaceBackgroundView
            android:id="@+id/intro_space"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/intro_logo"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:contentDescription="@string/app_short_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/intro_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.14"
                android:text="@string/app_short_name"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
