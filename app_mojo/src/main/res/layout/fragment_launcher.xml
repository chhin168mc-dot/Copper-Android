<?xml version="1.0" encoding="utf-8"?>
<!--
    Landscape main menu. The right pane is the whole screen: the player on the home screen and every
    other screen (mod store, accounts, editors, ...) above it. Quick Actions and Instance Tools are
    in the menu that slides in from the left edge.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 0 while the home screen or a full screen is open, 33% while Browse/Manage Content docks its picker on the left -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/pane_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0" />

    <!-- Only kept so the content picker can tell when it takes the left side -->
    <View
        android:id="@+id/left_sidebar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/left_pane_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/pane_guideline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/right_pane_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:clipToOutline="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/pane_guideline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginBottom="8dp" />

    <!-- Instance and play, at the bottom of the home screen only -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/_44sdp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.62">

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_instance_picker"
            android:drawableEnd="@drawable/spinner_arrow"
            android:textStyle="bold"
            app:drawableEndPadding="@dimen/_4sdp"
            app:drawableEndSize="@dimen/_16sdp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_32sdp" />

        <ImageButton
            android:id="@+id/edit_profile_button"
            android:layout_width="@dimen/_44sdp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_4sdp"
            android:background="@drawable/bg_instance_picker"
            android:src="@drawable/ic_px_edit" />

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/_4sdp"
            android:minWidth="@dimen/_96sdp"
            android:text="@string/main_play"
            android:textAllCaps="true" />
    </LinearLayout>

    <!-- The menu button is in the top bar of the activity, next to the settings button. A swipe from the left edge opens the menu too -->

    <View
        android:id="@+id/quick_menu_edge"
        android:layout_width="20dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/quick_menu_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/quick_menu_panel"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_space_panel"
        android:overScrollMode="never"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:paddingHorizontal="8dp"
                android:paddingTop="14dp"
                android:paddingBottom="4dp"
                android:text="@string/mcl_section_quick_actions"
                android:textAllCaps="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/news_button"
                style="@style/SpaceMenuButton"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_px_book"
                android:text="@string/mcl_tab_wiki" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/social_media_button"
                style="@style/SpaceMenuButton"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_social_media"
                android:text="@string/mcl_button_social_media" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/mod_store_button"
                style="@style/SpaceMenuButton"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_add"
                android:text="@string/mcl_button_mod_store" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/custom_control_button"
                style="@style/SpaceMenuButton"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_px_gamepad"
                android:text="@string/mcl_option_customcontrol" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:paddingHorizontal="8dp"
                android:paddingTop="14dp"
                android:paddingBottom="4dp"
                android:text="@string/mcl_section_instance_tools"
                android:textAllCaps="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_files_button"
                style="@style/SpaceMenuButton"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_folder_managed"
                android:text="@string/mcl_button_manage_mods" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/open_directory_button"
                style="@style/SpaceMenuButton"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_px_folder"
                android:text="@string/mcl_button_open_directory" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/install_jar_button"
                style="@style/SpaceMenuButton"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_px_java_run"
                android:text="@string/main_install_jar_file" />
            <com.kdt.mcgui.LauncherMenuButton
                android:id="@+id/share_logs_button"
                style="@style/SpaceMenuButton"
                android:layout_width="match_parent"
                android:layout_marginTop="6dp"
                android:drawableStart="@drawable/ic_px_sharelog"
                android:text="@string/main_share_logs" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
