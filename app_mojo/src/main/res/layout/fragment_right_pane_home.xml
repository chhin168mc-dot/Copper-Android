<?xml version="1.0" encoding="utf-8"?>
<!-- Home screen of the main menu: the player of the selected account in the middle of the space -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The wallpaper when it isn't fullscreen -->
    <com.kdt.mcgui.LauncherWallpaperView
        android:id="@+id/pane_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <View
        android:id="@+id/home_player_glow"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_glow" />

    <git.artdeell.mojo.skins.PlayerPreviewView
        android:id="@+id/home_player"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="44dp" />

    <TextView
        android:id="@+id/home_player_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_space_name_chip"
        android:ellipsize="end"
        android:maxLines="1"
        android:maxWidth="260dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="6dp"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</FrameLayout>
