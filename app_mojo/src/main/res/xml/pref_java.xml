<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app2="http://schemas.android.com/apk/res-auto">

    <git.artdeell.mojo.prefs.BackButtonPreference />

    <PreferenceCategory android:title="@string/preference_category_java_tweaks">
        <Preference
            android:key="install_jre"
            android:icon="@drawable/ic_px_runtime_mgr"
            android:persistent="false"
            android:summary="@string/multirt_subtitle"
            android:title="@string/multirt_title"/>

        <androidx.preference.EditTextPreference
            android:dialogTitle="@string/mcl_setting_title_javaargs"
            android:icon="@drawable/ic_px_console"
            android:key="javaArgs"
            android:singleLine="true"
            android:summary="@string/mcl_setting_subtitle_javaargs"
            android:title="@string/mcl_setting_title_javaargs" />

        <git.artdeell.mojo.prefs.CustomSeekBarPreference
            android:key="allocation"
            android:icon="@drawable/ic_px_ram"
            android:summary="@string/mcl_memory_allocation_subtitle"
            android:title="@string/mcl_memory_allocation"
            app2:showSeekBarValue="true"
            app2:min="@integer/memory_seekbar_min"
            app2:seekBarIncrement="@integer/memory_seekbar_increment"
            app2:selectable="false"/>

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:icon="@drawable/ic_px_java_run"
            android:key="java_sandbox"
            android:summary="@string/mcl_setting_java_sandbox_subtitle"
            android:title="@string/mcl_setting_java_sandbox" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/perf_category">
        <Preference
            android:icon="@drawable/ic_px_speed"
            android:key="perf_optimize"
            android:persistent="false"
            android:summary="@string/perf_optimize_summary"
            android:title="@string/perf_optimize_title" />

        <androidx.preference.ListPreference
            android:defaultValue="auto"
            android:entries="@array/perf_runtime_selection_names"
            android:entryValues="@array/perf_runtime_selection_values"
            android:icon="@drawable/ic_px_java"
            android:key="runtimeSelection"
            android:title="@string/perf_runtime_selection_title"
            app2:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:icon="@drawable/ic_px_zap"
            android:key="runtimePreload"
            android:summary="@string/perf_runtime_preload_summary"
            android:title="@string/perf_runtime_preload_title" />

        <SwitchPreferenceCompat
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="false"
            android:icon="@drawable/ic_px_speed"
            android:key="perfReport"
            android:summary="@string/perf_report_switch_summary"
            android:title="@string/perf_report_switch_title" />

        <Preference
            android:icon="@drawable/ic_px_info"
            android:key="perf_overview"
            android:persistent="false"
            android:summary="@string/perf_overview_summary"
            android:title="@string/perf_overview_title" />
    </PreferenceCategory>

</PreferenceScreen>